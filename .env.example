# Copy to .env for local development: cp .env.example .env

# --- API (NestJS) ---
PORT=3001
NODE_ENV=development

# --- Database (Postgres 16 + PostGIS) — see docker-compose.yml ---
DATABASE_URL=postgres://ridenow:ridenow@localhost:5432/ridenow

# --- Web apps (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:3001

# --- Geo (OpenStreetMap, keyless) — wired up in feature stories ---
NOMINATIM_URL=https://nominatim.openstreetmap.org
OSRM_URL=https://router.project-osrm.org

# --- OTP (Twilio) / Payments (Stripe test mode) — placeholders for feature stories ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
STRIPE_SECRET_KEY=
